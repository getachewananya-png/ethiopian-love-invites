# Supabase — required (server side)
# Project Settings → API in the Supabase dashboard
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Project Settings → API → "service_role" (Reveal). Server only: this key
# bypasses RLS. Never prefix it with VITE_ or it will leak to the browser.
# Never commit a real value here, not even into a file named .example.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Supabase — browser-exposed copies (safe, RLS-protected publishable key only)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Chapa payments — https://dashboard.chapa.co (only needed for the paid template)
CHAPA_SECRET_KEY=CHAPA_TEST-xxxxxxxx
CHAPA_WEBHOOK_SECRET=

# Guest invitation emails — https://resend.com/api-keys (used by the
# "Email" / "Mark sent" buttons on the guest list).
# RESEND_FROM must be a sender verified in Resend; on the free tier you can
# only send to your own address until you add a domain.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="Tizita <invites@yourdomain.com>"

# Absolute public origin, no trailing slash. Chapa redirects guests back here
# after paying, so it must be your real HTTPS origin in production.
PUBLIC_APP_URL=https://YOUR-DOMAIN.example

# Postgres connection string for `drizzle-kit migrate` (Project Settings →
# Database → Connection string, role=postgres). Unused at runtime.
LOVABLE_DB_MIGRATION_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
